<root>
    <styles>
        <include src="file://{resources}/layout/custom_game/styles/custom_loading_screen.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/layout/custom_game/custom_loading_screen.js" />
    </scripts>
    
    <!-- hittest="true" нужен, чтобы панель могла ловить клики -->
    <Panel class="AddonLoadingRoot" hittest="true" hittestchildren="true">
        <Panel id="CustomBg" />
        
        <!-- Контейнер-пустышка для проверки кнопок -->
        <Panel class="DummyContainer">
            <Label class="DummyTitle" text="ТЕСТ ЗАГРУЗОЧНОГО ЭКРАНА" />

            <Button class="DummyButton" onactivate="OpenExternalUrl('https://t.me/dota_rave')" hittest="true" hittestchildren="false">
                <Label text="TELEGRAM" />
            </Button>

            <Button class="DummyButton" onactivate="OpenExternalUrl('https://discord.gg/UkDezmuQTp')" hittest="true" hittestchildren="false">
                <Label text="DISCORD" />
            </Button>

            <Button class="DummyButton" onactivate="OpenExternalUrl('https://wtflegends.com/wiki')" hittest="true" hittestchildren="false">
                <Label text="WIKI" />
            </Button>
        </Panel>
    </Panel>
</root>