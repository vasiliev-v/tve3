<root>
    <styles>
        <include src="file://{resources}/layout/custom_game/styles/custom_loading_screen1.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/layout/custom_game/custom_loading_screen1.js" />
    </scripts>
    
    <!-- Корневая панель загрузочного экрана -->
    <Panel class="AddonLoadingRoot" hittest="true" hittestchildren="true">
        
        <!-- Панель советов (Слайдер) -->
        <Panel class="TipsContainer" hittest="true" hittestchildren="true">
            <!-- Заголовок -->
            <Label class="TipsHeader" text="СОВЕТЫ" hittest="false" />

            <!-- Тело со стрелками и контентом -->
            <Panel class="TipsBody" hittest="false">
                
                <!-- Левая стрелка -->
                <Button class="TipArrow" onactivate="ChangeTip(-1)" hittest="true" hittestchildren="false">
                    <Label text="◄" />
                </Button>

                <!-- Центральная часть (картинка + текст). ДОБАВЛЕН ID -->
                <Panel class="TipContent" id="TipContent" hittest="false">
                    <!-- Для картинок (3-й слайд) -->
                    <Image id="TipImage" scaling="stretch-to-fit-preserve-aspect" hittest="false" />
                    
                    <!-- Для видео (1, 2, 4 слайды) -->
                    <Movie id="TipVideo" autoplay="onload" repeat="true" controls="none" hittest="false" />
                    
                    <Label id="TipText" html="true" wrap="true" hittest="false" />
                </Panel>

                <!-- Правая стрелка -->
                <Button class="TipArrow" onactivate="ChangeTip(1)" hittest="true" hittestchildren="false">
                    <Label text="►" />
                </Button>
                
            </Panel>

            <!-- Контейнер для кругов навигации -->
            <Panel id="TipDotsContainer" hittest="true" hittestchildren="true" />
            
        </Panel>
        
    </Panel>
</root>